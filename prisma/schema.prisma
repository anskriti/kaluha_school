datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  name           String
  username       String   @unique
  email          String   @unique
  mobile         String   @unique
  password       String
  role           String   @default("STUDENT") // "ADMIN", "FACULTY", "STUDENT"
  verified       Boolean  @default(false)
  className      String?
  fatherName     String?
  rollNumber     String?
  dob            String?
  approvalStatus String   @default("APPROVED") // "APPROVED", "PENDING", "REJECTED"
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notice {
  id       String   @id @default(uuid())
  title    String
  category String   // "GENERAL", "ACADEMICS", "EXAMS", "ADMISSIONS"
  content  String
  pdfUrl   String?
  pinned   Boolean  @default(false)
  date     DateTime @default(now())
}

model Homework {
  id          String   @id @default(uuid())
  className   String   // e.g. "V", "VI", "VII", "VIII", "IX", "X"
  subject     String
  title       String
  instruction String
  fileUrl     String?
  facultyId   String
  facultyName String
  deadline    DateTime
  createdAt   DateTime @default(now())
}

model Assignment {
  id          String   @id @default(uuid())
  className   String
  subject     String
  title       String
  instruction String
  fileUrl     String?
  facultyId   String
  facultyName String
  deadline    DateTime
  createdAt   DateTime @default(now())
}

model StudyMaterial {
  id          String   @id @default(uuid())
  className   String
  subject     String
  title       String
  description String?
  fileUrl     String
  facultyId   String
  facultyName String
  createdAt   DateTime @default(now())
}

model Result {
  id           String   @id @default(uuid())
  studentId    String   // student's username or user profile
  studentName  String
  className    String
  rollNumber   String
  examType     String   // e.g., "First Unit Test", "Madhyamik Mock"
  subjectMarks String   // JSON string: {"Bengali": 85, "English": 78, ...}
  totalMarks   Int
  percentage   Float
  status       String   // "PASS" or "FAIL"
  createdAt    DateTime @default(now())
}

model Application {
  id          String   @id @default(uuid())
  type        String   // "ADMISSION", "LIBRARY_CARD", "LEAVE", "TC", "NOC"
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  studentId   String
  studentName String
  data        String   // JSON string containing application-specific fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String
  status    String   @default("NEW") // "NEW", "RESOLVED"
  createdAt DateTime @default(now())
}

model AlumniProfile {
  id           String   @id @default(uuid())
  name         String
  batchYear    String
  email        String
  mobile       String
  profession   String
  achievements String?
  status       String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt    DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  name      String
  email     String
  role      String   // "PARENT", "STUDENT", "VISITOR", "ALUMNI"
  content   String
  rating    Int
  createdAt DateTime @default(now())
}

model Complaint {
  id          String   @id @default(uuid())
  studentId   String
  studentName String
  title       String
  description String
  response    String?
  status      String   @default("PENDING") // "PENDING", "RESOLVED"
  createdAt   DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  category    String   @default("EVENT") // "EXAM", "HOLIDAY", "SPORTS", "EVENT"
  createdAt   DateTime @default(now())
}

model Teacher {
  id            String   @id @default(uuid())
  name          String
  designation   String
  qualification String
  subjects      String
  imageUrl      String?
  phone         String?
  email         String?
  joinDate      String?
}

model SMCMember {
  id          String   @id @default(uuid())
  name        String
  designation String
  photoUrl    String?
}

model ManagingCommitteeMember {
  id          String   @id @default(uuid())
  name        String
  designation String
  photoUrl    String?
}

model WebSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String // JSON configuration or plain string
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
